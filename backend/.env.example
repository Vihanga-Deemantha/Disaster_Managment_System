# Copy this file to backend/.env, or simply run `npm run setup` from the repository root:
# that creates backend/.env and fills in fresh random secrets for you.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# A local MongoDB, `docker compose up -d mongo`, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/safezone_dev

# Origins allowed to call the API with cookies (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- Secrets: `npm run setup` replaces these markers. Never commit real values. ---
# At least 32 random characters. Signs the 15-minute access tokens.
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
# 32 random bytes, base64. Encrypts citizen NICs at rest (AES-256-GCM).
NIC_ENCRYPTION_KEY=__NIC_ENCRYPTION_KEY__
# 32 random bytes, base64. Keys the HMAC used to detect duplicate NICs.
NIC_HASH_KEY=__NIC_HASH_KEY__

# Optional: override the shared password of the seeded demo accounts.
# SEED_PASSWORD=
