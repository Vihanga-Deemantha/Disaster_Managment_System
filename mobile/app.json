{
  "expo": {
    "name": "Safe Zone",
    "slug": "safezone",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safezone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "lk.safezone.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "lk.safezone.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-background-task",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Safe Zone uses your location to place your hazard report on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Safe Zone uses the camera to attach a photo to your hazard report.",
          "photosPermission": "Safe Zone lets you attach an existing photo to your hazard report."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
